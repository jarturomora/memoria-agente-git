# Copia este archivo como .env. No publiques claves reales.

# Docker Compose usa esta versión para Elasticsearch y Kibana.
ELASTIC_VERSION=9.5.6

# La aplicación Python se conecta al puerto publicado en el equipo local.
ELASTICSEARCH_URL=http://localhost:9200

# Índices independientes para conocimiento documental y memoria persistente.
ELASTICSEARCH_INDEX=progit
MEMORY_INDEX=agent-memories

# Opcional: solo para generación con LLM remoto (puede tener coste)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
